# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Somente a chave PÚBLICA é usada pelo app.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Projetos antigos podem usar a "anon key" no lugar da publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
